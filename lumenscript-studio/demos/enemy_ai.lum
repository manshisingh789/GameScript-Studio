let state = 0
let distance = 12
let patrolCount = 0

on key_press p: {
    patrolCount = patrolCount + 1
    distance = distance - 2

    if state == 0: {
        print("Enemy is patrolling.")
        
        if distance < 10: {
            state = 1
            print("Enemy has detected the player!")
        }
    } else: {
        print("Enemy is chasing.")

        if distance < 4: {
            state = 0
            distance = 12
            print("Enemy lost track of the player.")
        }
    }

    print("Patrol count:")
    print(patrolCount)
}